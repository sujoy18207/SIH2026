# Map tile provider configuration for the risk dashboard.
#
# OpenStreetMap's public tile server is intended for light / development use.
# For production or high-traffic deployments, point VITE_MAP_TILE_URL at a
# self-hosted OSM tile server, a commercial provider, or an institutional tile
# CDN, and set VITE_MAP_TILE_ATTRIBUTION to the correct required attribution.

# Default = official OSM raster tiles (dev / demo only, not for high volume).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Attribution string that must appear on the map (OpenStreetMap requires it).
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
